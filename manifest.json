{
  "manifest_version": 3,
  "name": "TheTab.Ninja - New tab bookmark manager, tab organizer & GitHub sync",
  "short_name": "TheTab.Ninja",
  "version": "1.2",
  "description": "Replace your new tab with a powerful bookmark manager. Organize tabs, collections & workspaces. Sync via GitHub or Google Drive. Import from Toby. Dark mode.",

  "icons": {
    "128": "assets/light-128.png"
  },

  "action": {
    "default_popup": "popup.html",

    "default_icon": {
      "128": "assets/light-128.png"
    },

    "theme_icons": [
      {
        "light": "assets/light-128.png",
        "dark":  "assets/dark-128.png",
        "size": 128
      }
    ]
  },

  "chrome_url_overrides": {
    "newtab": "bm.html"
  },
  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "tabs",
    "windows",
    "tabGroups",
    "downloads",
    "alarms",
    "storage",
    "identity"
  ],
  "oauth2": {
    "client_id": "442085333687-kt690qjh48p5fkg0d620c3qhl2ea21nq.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  },
  "host_permissions": [
    "https://www.google.com/*",
    "https://*.gstatic.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://www.googleapis.com/*",
    "https://accounts.google.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
