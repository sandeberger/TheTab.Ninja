{
  "manifest_version": 3,
  "name": "TheTab.Ninja – Smart new tab start page & bookmark manager",
  "version": "1.14",
  "description": "New tab page & bookmark manager that becomes your personal launchpad. Sync privately via GitHub. Organize tabs & bookmarks fast.",

  "icons": {
    "128": "images/icons/light-128.png"
  },

  "action": {
    "default_popup": "popup.html",

    "default_icon": {
      "128": "images/icons/light-128.png"
    },

    "theme_icons": [
      {
        "light": "images/icons/light-128.png",
        "dark":  "images/icons/dark-128.png",
        "size": 128
      }
    ]
  },

  "chrome_url_overrides": {
    "newtab": "bm.html"
  },
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },

  "permissions": [
    "tabs",
    "windows",
    "tabGroups",
    "downloads",
    "alarms",
    "storage",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://*.gstatic.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "442085333687-kt690qjh48p5fkg0d620c3qhl2ea21nq.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file",
      "https://www.googleapis.com/auth/drive.appdata"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
