{
  "manifest_version": 3,
  "name": "TheTab.Ninja – Smart new tab start page & bookmark manager",
  "version": "1.2",
  "description": "New tab page & bookmark manager that becomes your personal launchpad. Sync privately via GitHub. Organize tabs & bookmarks fast.",

  "icons": {
    "128": "assets/light-128.png"
  },

  "action": {
    "default_popup": "popup.html",
    
    "default_icon": {
      "128": "assets/light-128.png"
    },
    
    "theme_icons": [
      {
        "light": "assets/light-128.png",
        "dark":  "assets/dark-128.png",
        "size": 128
      }
    ]
  },

  "chrome_url_overrides": {
    "newtab": "bm.html"
  },
  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "tabs",
    "windows",
    "tabGroups",
    "downloads",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://*.gstatic.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
